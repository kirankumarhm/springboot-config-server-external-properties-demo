<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every exclusion below is a deliberate, justified decision - not a way to silence a real finding.
-->
<FindBugsFilter>

  <!--
    EI_EXPOSE_REP2: SpotBugs flags storing a reference to a mutable object. Here that is the
    entire point: the controller must hold the SAME @ConfigurationProperties object that a
    refresh updates in place. A defensive copy would freeze the startup values.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!--
    SPRING_CSRF_PROTECTION_DISABLED: FindSecBugs flags disabling CSRF. This service is a stateless,
    read-only REST API with no cookies and no sessions, so there is no CSRF attack surface.
  -->
  <Match>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
  </Match>

  <!-- Test sources are not production code paths. -->
  <Match>
    <Source name="~.*[\\/]src[\\/]test[\\/].*"/>
  </Match>

</FindBugsFilter>
