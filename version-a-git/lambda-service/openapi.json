{
  "openapi": "3.0.3",
  "info": {
    "title": "Lambda Service API",
    "version": "1.0.0",
    "description": "An AWS Lambda function behind an API Gateway HTTP API. Returns the lambda.* configuration from Spring Cloud Config Server, read on every invocation so a change is visible on the next call.",
    "license": { "name": "Apache 2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0" }
  },
  "paths": {
    "/api/v1/lambda/config": {
      "get": {
        "tags": ["Lambda configuration"],
        "summary": "Get the current lambda configuration",
        "operationId": "getLambdaConfig",
        "responses": {
          "200": { "description": "The configuration from the Config Server", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LambdaConfig" } } } },
          "404": { "$ref": "#/components/responses/Problem" },
          "405": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Problem": { "description": "Error, as RFC 9457 problem details", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "LambdaConfig": {
        "type": "object",
        "required": ["greeting", "featureEnabled", "maxItems"],
        "properties": {
          "greeting": { "type": "string", "example": "Hello from AWS Lambda" },
          "featureEnabled": { "type": "boolean", "example": true },
          "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000, "example": 10 }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "integer" },
          "detail": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" },
          "errorId": { "type": "string" }
        }
      }
    }
  }
}
